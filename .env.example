# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional third-party features
# Enable only after the corresponding third-party service
# is actually integrated and consent-controlled.
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ADS=false

# Cloudflare Turnstile bot protection for contact form
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_EMAIL=
