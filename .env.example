# Canonical public URL used for self-referential links and deployment-aware features.
APP_URL="https://conversordeletrasbonitas.net"

# Optional advertising. Leave disabled until a real advertising provider is integrated
# and the corresponding consent flow is enabled.
VITE_ENABLE_ADS=false

# Cloudflare Turnstile bot protection for the contact form.
# Configure BOTH values in production. If either side is omitted, Turnstile protection
# is not complete.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact email delivery through Resend.
RESEND_API_KEY=
CONTACT_EMAIL=
